# Shared
NODE_ENV=development
APP_PORT=4000
PANEL_PORT=3000
AGENT_PORT=4010
DATABASE_URL=postgresql://selfhosted:selfhosted@localhost:5432/self_hosted
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-long-random-secret
MASTER_ENCRYPTION_KEY=replace-with-32-bytes-base64
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_ALLOWLIST=your-github-username

# Route and tunnel control
CADDY_ADMIN_URL=http://127.0.0.1:2019
RATHOLE_SERVER_CONFIG_PATH=/etc/rathole/server.toml
RATHOLE_RELOAD_COMMAND=systemctl reload rathole-server

# Agent channel
CONTROL_CHANNEL_SHARED_SECRET=replace-with-random-token

# Node agent
API_BASE_URL=http://localhost:4000
AGENT_NODE_NAME=local-node
AGENT_VERSION=0.1.0
ENROLLMENT_TOKEN=
NODE_ID=
NODE_TOKEN=
AGENT_STATE_FILE=.agent-state.json
AGENT_WORKDIR=./agent-workdir
RATHOLE_SERVER_ADDR=127.0.0.1:2333
RATHOLE_CLIENT_CONFIG_PATH=/etc/rathole/client.toml
RATHOLE_CLIENT_RELOAD_COMMAND=systemctl reload rathole-client
