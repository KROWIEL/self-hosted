generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  admin
  operator
  viewer
}

enum NodeStatus {
  online
  offline
  unknown
}

enum RouteStatus {
  pending
  synced
  failed
}

enum AppStatus {
  unknown
  running
  stopped
  error
}

enum DeployStatus {
  queued
  running
  succeeded
  failed
}

enum GitCredentialType {
  pat
  ssh_key
}

model User {
  id           String       @id @default(cuid())
  githubId     String?      @unique
  githubLogin  String?      @unique
  email        String?      @unique
  displayName  String?
  avatarUrl    String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  roles        UserRole[]
  auditEvents  AuditEvent[]
  deployJobs   DeployJob[]
  createdInvites          UserInvite[]
  createdEnrollmentTokens EnrollmentToken[]
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserInvite {
  id          String    @id @default(cuid())
  githubLogin String?   @unique
  email       String?   @unique
  roleName    RoleName  @default(viewer)
  isActive    Boolean   @default(true)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Node {
  id              String            @id @default(cuid())
  name            String
  status          NodeStatus        @default(unknown)
  agentVersion    String?
  enrolledAt      DateTime          @default(now())
  lastSeenAt      DateTime?
  accessTokenHash String?
  metadataJson    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  apps            App[]
  logs            AppLog[]
  enrollments     EnrollmentToken[]
}

model EnrollmentToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdById String?
  createdBy  User?     @relation(fields: [createdById], references: [id])
  nodeId     String?
  node       Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

model App {
  id                String          @id @default(cuid())
  nodeId            String
  node              Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  name              String
  repoUrl           String
  branch            String
  composePath       String
  serviceName       String
  healthcheckUrl    String?
  cpuLimit          String
  memoryLimit       String
  status            AppStatus       @default(unknown)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  envVars           AppEnvVar[]
  gitCredentials    GitCredential[]
  routes            AppRoute[]
  deployJobs        DeployJob[]
  deployRevisions   DeployRevision[]
  logs              AppLog[]

  @@unique([nodeId, name])
}

model AppEnvVar {
  id             String   @id @default(cuid())
  appId          String
  app            App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  key            String
  valueEncrypted String
  isSecret       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([appId, key])
}

model GitCredential {
  id               String            @id @default(cuid())
  appId            String
  app              App               @relation(fields: [appId], references: [id], onDelete: Cascade)
  type             GitCredentialType
  username         String?
  secretEncrypted  String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model AppRoute {
  id         String      @id @default(cuid())
  appId      String
  app        App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  domain     String      @unique
  targetPort Int
  bindPort   Int
  status     RouteStatus @default(pending)
  lastSyncAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model DeployJob {
  id          String       @id @default(cuid())
  appId       String
  app         App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  triggeredById String?
  triggeredBy User?        @relation(fields: [triggeredById], references: [id])
  gitRef      String
  status      DeployStatus @default(queued)
  startedAt   DateTime?
  finishedAt  DateTime?
  errorText   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DeployRevision {
  id               String   @id @default(cuid())
  appId            String
  app              App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  gitRef           String
  deployedAt       DateTime @default(now())
  rollbackOfJobId  String?
}

model AppLog {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  ts        DateTime
  stream    String
  line      String
  createdAt DateTime @default(now())

  @@index([appId, ts])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())
}
