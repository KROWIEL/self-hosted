{
  "slug": "calibre-web",
  "name": "Calibre-Web",
  "description": "Clean web library for browsing, reading and sending books from a Calibre database.",
  "category": "Documents",
  "translations": {
    "ru": {
      "description": "Веб-библиотека для просмотра, чтения и отправки книг из базы Calibre."
    }
  },
  "icon": "doc",
  "upstream": "calibre-web",
  "deployKind": "image",
  "image": "lscr.io/linuxserver/calibre-web:latest",
  "defaultPort": 8083,
  "recommendedVolumes": [
    {
      "mountPath": "/config"
    },
    {
      "mountPath": "/books"
    }
  ],
  "envDefaults": [
    {
      "key": "PUID",
      "value": "1000"
    },
    {
      "key": "PGID",
      "value": "1000"
    },
    {
      "key": "TZ",
      "value": "UTC"
    }
  ],
  "meta": {
    "about": "Browse, read and download eBooks using an existing Calibre database.",
    "license": "GPL-3.0",
    "tags": [
      "Document Management - E-books"
    ],
    "stars": 17755,
    "updatedAt": "2026-05-24",
    "links": {
      "website": "https://github.com/janeczku/calibre-web",
      "source": "https://github.com/janeczku/calibre-web"
    }
  }
}
