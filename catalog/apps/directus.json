{
  "slug": "directus",
  "name": "Directus",
  "description": "Instant REST and GraphQL API plus an admin app on top of your own SQL database.",
  "category": "Databases",
  "translations": {
    "ru": {
      "description": "Мгновенный REST- и GraphQL-API и админ-панель поверх вашей SQL-базы."
    }
  },
  "icon": "database",
  "upstream": "directus",
  "deployKind": "image",
  "image": "directus/directus:12",
  "defaultPort": 8055,
  "recommendedVolumes": [
    {
      "mountPath": "/directus/database"
    },
    {
      "mountPath": "/directus/uploads"
    }
  ],
  "envDefaults": [
    {
      "key": "KEY",
      "secret": true,
      "required": true
    },
    {
      "key": "SECRET",
      "secret": true,
      "required": true
    },
    {
      "key": "DB_CLIENT",
      "value": "sqlite3"
    },
    {
      "key": "DB_FILENAME",
      "value": "/directus/database/data.db"
    },
    {
      "key": "ADMIN_EMAIL",
      "value": "admin@example.com"
    },
    {
      "key": "ADMIN_PASSWORD",
      "secret": true,
      "required": true
    }
  ],
  "meta": {
    "about": "An Instant App & API for your SQL Database. Directus wraps your new or existing SQL database with a realtime GraphQL+REST API for developers, and an intuitive admin app for non-technical users.",
    "license": "BUSL-1.1",
    "tags": [
      "Database Management"
    ],
    "stars": 36911,
    "updatedAt": "2026-07-27",
    "links": {
      "website": "https://directus.io/",
      "source": "https://github.com/directus/directus"
    }
  }
}
