{
  "slug": "freshrss",
  "name": "FreshRSS",
  "description": "Self-hosted feed aggregator with multi-user support, filters and a mobile-friendly UI.",
  "category": "Feeds",
  "translations": {
    "ru": {
      "description": "Агрегатор RSS-лент с поддержкой нескольких пользователей, фильтрами и мобильным интерфейсом."
    }
  },
  "icon": "rss",
  "upstream": "freshrss",
  "deployKind": "image",
  "image": "freshrss/freshrss:latest",
  "defaultPort": 80,
  "recommendedVolumes": [
    {
      "mountPath": "/var/www/FreshRSS/data"
    },
    {
      "mountPath": "/var/www/FreshRSS/extensions"
    }
  ],
  "envDefaults": [
    {
      "key": "TZ",
      "value": "UTC"
    },
    {
      "key": "CRON_MIN",
      "value": "*/20"
    }
  ],
  "meta": {
    "about": "Self-hostable RSS feed aggregator.",
    "license": "AGPL-3.0",
    "tags": [
      "Feed Readers"
    ],
    "stars": 15622,
    "updatedAt": "2026-07-24",
    "links": {
      "website": "https://freshrss.org/",
      "source": "https://github.com/FreshRSS/FreshRSS",
      "demo": "https://demo.freshrss.org/i/"
    }
  }
}
