  "recommendedVolumes": [
    {
      "mountPath": "/data"
    }
  ],
  "envDefaults": [
    {
      "key": "SIGNUPS_ALLOWED",
      "value": "true"
    },
    {
      "key": "ADMIN_TOKEN",
      "secret": true,
      "required": false
    }
  ],
