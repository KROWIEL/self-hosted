{
  "slug": "vaultwarden",
  "name": "Vaultwarden",
  "description": "Bitwarden-compatible password manager for home labs.",
  "category": "Security",
  "translations": {
    "ru": {
      "description": "Менеджер паролей, совместимый с Bitwarden, для домашней лаборатории."
